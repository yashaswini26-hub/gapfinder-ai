# ==============================================================================
# GapFinder AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or production keys to version control.
# ==============================================================================

# Application URL
# Used for authentication callbacks and absolute redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Create a Supabase project at https://supabase.com
# Found in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Publishable Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Secret Key (REQUIRED FOR SERVER-ONLY OPERATIONS)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles.
# Used for executing background document chunk storage, private storage bucket access,
# and secure question answer key persistence.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Storage Bucket for user study materials (Private bucket)
SUPABASE_STORAGE_BUCKET="course_materials"

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# NEVER expose this key to client-side code.
GEMINI_API_KEY="AIzaSy..."

# Primary LLM Model for diagnostic generation, syllabus parsing, and grading
# Supported options: gemini-3-flash-preview, gemini-2.5-flash, gemini-flash-latest
GEMINI_MODEL="gemini-3-flash-preview"

# Embedding Model for Document Ingestion and Vector Retrieval
# Configured with outputDimensionality: 768 to match pgvector schema definition
# Supported options: gemini-embedding-001, text-embedding-004
EMBEDDING_MODEL="gemini-embedding-001"

# ------------------------------------------------------------------------------
# RAG & Scoring Heuristics (Optional Overrides)
# ------------------------------------------------------------------------------
# Cosine similarity minimum threshold for chunk retrieval (0.0 to 1.0)
RAG_SIMILARITY_THRESHOLD="0.45"

# Maximum number of relevant chunks to retrieve per diagnostic question
RAG_TOP_K="4"
